PORT=8081
LOG_LEVEL=INFO

# --- File provider mode (default) ---
# CONFIG_PROVIDER=file
#CONFIG_FILE=config.dev.yaml

# --- HTTP provider mode (fetches all config from control-api per request) ---
CONFIG_PROVIDER=http
CONTROL_API_URL=http://localhost:9090
INTERNAL_API_KEY=change-me-internal-secret-key

GIN_MODE=debug # debug | test | release
DEBUG=true

# --- x402 facilitator timeouts ---
# X402_TIMEOUT: verify + per-request deadline (fast call)
# X402_SETTLE_TIMEOUT: on-chain settlement deadline; mainnet settle can take
# much longer than verify. Accepts Go durations (e.g. 30s, 2m).
X402_TIMEOUT=30s
X402_SETTLE_TIMEOUT=120s
